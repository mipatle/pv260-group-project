@model PV260.ArkFundsTracker.Web.Slices.Home.HomePageViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="mb-4">
                <h1 class="display-4">@Model.ApplicationName</h1>
                <p class="lead text-muted fs-4">
                    Real-time insights and automated tracking for <strong>Ark Invest</strong> holdings.
                </p>
            </div>

            <hr class="w-25 mx-auto my-4" />

            <div class="card border-0 shadow-sm bg-light mx-auto" style="max-width: 500px;">
                <div class="card-body py-4">
                    <p class="mb-1 text-uppercase fw-semibold text-secondary small tracking-wider">Developed By</p>
                    <h5 class="mb-0">PV260 Notino group <span class="text-primary">Team-1</span></h5>
                </div>
            </div>

            <div class="mt-5">
                <a asp-controller="FundPosition" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">View Holdings</a>
                <a href="https://github.com/mipatle/pv260-group-project/" class="btn btn-outline-secondary btn-lg px-4">Repository</a>
            </div> 
        </div>
    </div>
</div>
