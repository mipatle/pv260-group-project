# Runtime mode for the web app inside docker compose.
# Allowed values typically: Development, Production
APP_ENVIRONMENT=Development

# Web app port exposed on the host machine.
WEB_PORT=8080

# PostgreSQL container settings.
POSTGRES_IMAGE=postgres:17
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=arkfundsDB
POSTGRES_PORT=5434
